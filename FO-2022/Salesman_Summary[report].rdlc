<Textbox xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" Name="TxtLeft1">
  <CanGrow>true</CanGrow>
  <KeepTogether>true</KeepTogether>
  <Paragraphs>
    <Paragraph>
      <TextRuns>
        <TextRun>
          <Value>="Customer Name: " &amp; IIF(CountDistinct(Fields!CustomerName.Value, "DataSet1") = 1, First(Fields!CustomerName.Value, "DataSet1"), "Multiple Customers")</Value>
          <Style>
            <FontFamily>Arial</FontFamily>
            <FontSize>8pt</FontSize>
            <FontWeight>Bold</FontWeight>
